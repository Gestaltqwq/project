                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"student01\", \"password\": \"stu123456\"}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"user_token\", pm.response.json().data.access_token);"
                ]
