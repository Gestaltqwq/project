# 环境变量模板：复制为 .env 后填写（.env 不入库）
FLASK_ENV=development

# JWT 密钥（必须为 ≥16 位强随机密钥，占位符会导致启动报错）
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-random-string

# 数据库地址
DATABASE_URL=sqlite:///./instance/insurance.db

# 大模型配置（openai 兼容接口：deepseek/qwen/glm/kimi）
# 申请地址示例：DeepSeek https://platform.deepseek.com
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
